# ==============================================================================
# LIGHTHOUSE ENVIRONMENT DECLARATION (.env.example)
# Never commit secrets or populated credentials to this file.
# ==============================================================================

# Public Firebase Web Client Configuration (These identify the Firebase project; they are public)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Optional runtime alternatives for public /api/config endpoint in Cloud Run
FIREBASE_WEB_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""

# Server-Only Configuration
# In Cloud Run, inject GEMINI_API_KEY strictly from Google Cloud Secret Manager.
# In local development, you may place it in a gitignored .env.local file.
GEMINI_API_KEY=""
GOOGLE_CLOUD_PROJECT=""

# Opt-in Firebase Emulator Settings (Uncomment only when running local Firebase emulators)
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8085"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# VITE_USE_FIREBASE_EMULATOR="true"
